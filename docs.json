{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Metaphysical Studio Docs",
  "description": "Simple documentation for using Metaphysical Studio to manage 3D manual projects, assets, messages, revisions, and account access.",
  "colors": {
    "primary": "#FD936E",
    "light": "#FAFAFB",
    "dark": "#8181FF"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "family": "Poppins",
    "weight": 500,
    "format": "woff"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start Here",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Using the App",
        "pages": [
          "projects-and-assets",
          "messages-and-revisions",
          "account-billing-support"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/floweroflife.svg",
    "dark": "/images/floweroflife.svg"
  },
  "background": {
    "decoration": "grid"
  },
  "favicon": "/images/floweroflife.svg"
}
